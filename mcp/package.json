{
  "name": "leash-near-mcp",
  "version": "0.2.0",
  "description": "MCP server that lets an AI agent pay in USDC on NEAR, inside limits its owner sets with Leash",
  "type": "module",
  "bin": {
    "leash-near-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "near-api-js": "^7.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "near",
    "usdc",
    "agent",
    "payments",
    "leash"
  ],
  "license": "MIT"
}
